generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  criadoEm DateTime @default(now())

  sessoes     Sessao[]
  iaResponses IAResponse[]
}

model Paciente {
  id    Int    @id @default(autoincrement())
  name  String
  idade Int

  sessoes     Sessao[]
  iaResponses IAResponse[]
}

model Sessao {
  id             Int      @id @default(autoincrement())
  data           DateTime
  observacao     String?
  pacienteId     Int
  usuarioId      Int
  dataHoraInicio DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  iaResponses IAResponse[]
}

model IAResponse {
  id Int @id @default(autoincrement())

  tipo     String
  modelo   String
  prompt   String
  resposta String

  sessaoId   Int?
  pacienteId Int?
  usuarioId  Int?

  criadoEm DateTime @default(now())

  sessao   Sessao?   @relation(fields: [sessaoId], references: [id])
  paciente Paciente? @relation(fields: [pacienteId], references: [id])
  usuario  Usuario?  @relation(fields: [usuarioId], references: [id])
}
