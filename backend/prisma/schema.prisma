generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  createdAt DateTime @default(now())
}
model paciente{
  id Int @id @default(autoincrement())
  name String
  idade Int
}
