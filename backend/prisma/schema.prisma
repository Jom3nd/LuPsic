generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha  String
  criadoEm DateTime @default(now())

  sessoes Sessao[]
}

model Paciente {
  id    Int    @id @default(autoincrement())
  name  String
  idade Int

  sessoes Sessao[]
}

model Sessao {
  id         Int      @id @default(autoincrement())
  data       DateTime
  observacao String?
  pacienteId Int
  usuarioId  Int
  dataHoraInicio DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
}
