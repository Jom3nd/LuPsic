generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MASTER
  PROFISSIONAL
  FUNCIONARIO
  PACIENTE
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

model Usuario {
  id            Int              @id @default(autoincrement())
  nome          String
  email         String           @unique
  senha         String
  role          Role             @default(PROFISSIONAL)
  criadoEm      DateTime         @default(now())

  pacientes     Paciente[]
  sessoes       Sessao[]
  respostas     IAResponse[]
  refreshTokens RefreshToken[]
  agendamentos Agendamento[]
}

model Agendamento{
  id             Int      @id @default(autoincrement())
  dataHoraInicio DateTime
  observacao     String?
  status         StatusAgendamento @default(PENDENTE)

  usuarioId      Int
  pacienteId     Int

  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  paciente       Paciente @relation(fields: [pacienteId], references: [id])
}
model Sala{
  id             Int @id
  numeroDaSala   Int
  situacao       Boolean @default(true)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([usuarioId])
}

model Paciente {
  id         Int      @id @default(autoincrement())
  name       String
  email      String?  @unique
  senha      String?
  idade      Int
  criadoEm   DateTime @default(now())

  usuarioId  Int?
  usuario    Usuario?  @relation(fields: [usuarioId], references: [id])

  sessoes    Sessao[]
  respostas  IAResponse[]
  agendamentos Agendamento[]
}

model Sessao {
  id              Int      @id @default(autoincrement())
  dataHoraInicio  DateTime
  observacao      String?

  usuarioId       Int
  pacienteId      Int

  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  paciente        Paciente @relation(fields: [pacienteId], references: [id])

  respostas       IAResponse[]
}

model IAResponse {
  id          Int      @id @default(autoincrement())
  tipo        String
  modelo      String
  prompt      String
  resposta    String
  criadoEm    DateTime @default(now())

  usuarioId   Int
  pacienteId  Int?
  sessaoId    Int?

  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  paciente    Paciente? @relation(fields: [pacienteId], references: [id])
  sessao      Sessao?   @relation(fields: [sessaoId], references: [id])
}
