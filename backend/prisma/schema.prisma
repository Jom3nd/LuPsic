generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MASTER
  PROFISSIONAL
  FUNCIONARIO
  PACIENTE
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

enum StatusSala {
  ATIVA
  INATIVA
  MANUTENCAO
  LIMPEZA
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  especialidade String?
  role     Role     @default(PROFISSIONAL)
  criadoEm DateTime @default(now())

  pacientes      Paciente[]     @relation("ProfissionalPacientes")
  pacientePerfil Paciente?      @relation("PacienteUsuario")
  sessoes        Sessao[]
  respostas      IAResponse[]
  refreshTokens  RefreshToken[]
  agendamentos   Agendamento[]
}

model Agendamento {
  id             Int               @id @default(autoincrement())
  dataHoraInicio DateTime
  dataHoraFim    DateTime
  observacao     String?
  status         StatusAgendamento @default(PENDENTE)

  usuarioId  Int
  pacienteId Int
  salaId     Int

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  sala     Sala     @relation(fields: [salaId], references: [id])
  sessao   Sessao?

  // Índices para otimizar consultas na agenda
  @@index([usuarioId, dataHoraInicio])
  @@index([salaId, dataHoraInicio])
}

model Sala {
  id           Int           @id @default(autoincrement())
  nome         String        @unique
  numeroDaSala Int           @unique
  situacao     StatusSala    @default(ATIVA)
  atualizadoEm DateTime      @updatedAt
  agendamentos Agendamento[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model Paciente {
  id    Int @id @default(autoincrement())
  idade Int
  // Removidos: nome, email e senha (agora herda do Usuario)

  usuarioId Int?     @unique
  usuario   Usuario? @relation("PacienteUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  profissionalId Int?
  profissional   Usuario? @relation("ProfissionalPacientes", fields: [profissionalId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sessoes      Sessao[]
  respostas    IAResponse[]
  agendamentos Agendamento[]
}

model Sessao {
  id             Int      @id @default(autoincrement())
  dataHoraInicio DateTime
  status         String   @default("REALIZADA")
  observacao     String? // Criptografar no código

  agendamentoId Int?         @unique
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarioId  Int
  pacienteId Int

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  respostas IAResponse[]
}

model IAResponse {
  id       Int      @id @default(autoincrement())
  tipo     String
  modelo   String
  prompt   String
  resposta String
  criadoEm DateTime @default(now())

  usuarioId  Int
  pacienteId Int?
  sessaoId   Int?

  usuario  Usuario   @relation(fields: [usuarioId], references: [id])
  paciente Paciente? @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  sessao   Sessao?   @relation(fields: [sessaoId], references: [id])
}
