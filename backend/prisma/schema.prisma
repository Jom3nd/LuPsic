generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id         Int          @id @default(autoincrement())
  nome       String
  email      String       @unique
  senha      String
  criadoEm   DateTime     @default(now())

  pacientes  Paciente[]
  sessoes    Sessao[]
  respostas  IAResponse[]
}

model Paciente {
  id         Int      @id @default(autoincrement())
  name       String
  idade      Int

  usuarioId  Int?
  usuario    Usuario?  @relation(fields: [usuarioId], references: [id])

  sessoes    Sessao[]
  respostas  IAResponse[]
}

model Sessao {
  id              Int      @id @default(autoincrement())
  dataHoraInicio  DateTime
  observacao      String?

  usuarioId       Int
  pacienteId      Int

  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  paciente        Paciente @relation(fields: [pacienteId], references: [id])

  respostas       IAResponse[]
}

model IAResponse {
  id          Int      @id @default(autoincrement())
  tipo        String
  modelo      String
  prompt      String
  resposta    String
  criadoEm    DateTime @default(now())

  usuarioId   Int
  pacienteId  Int?
  sessaoId    Int?

  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  paciente    Paciente? @relation(fields: [pacienteId], references: [id])
  sessao      Sessao?   @relation(fields: [sessaoId], references: [id])
}
